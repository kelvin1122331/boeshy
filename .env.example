DATABASE_URL=postgresql://holyai:holyai@localhost:5432/holyai
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-random-32-byte-secret
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# OPENAI and/or ANTHROPIC; leave empty for honest configuration states
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VIDEO_MODEL=sora-2
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5
TEXT_PROVIDER=openai
MONTHLY_GENERATION_LIMIT=200
RESEND_API_KEY=
EMAIL_FROM=HOLYAI <noreply@example.com>
REQUIRE_EMAIL_VERIFICATION=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TAVILY_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=holyai
S3_ACCESS_KEY_ID=holyai
S3_SECRET_ACCESS_KEY=change-me-storage-secret
S3_FORCE_PATH_STYLE=true
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/integrations/canva/callback
# 64 hex characters; openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
