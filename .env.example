DATABASE_URL=postgresql://holyai:holyai@localhost:5432/holyai
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-random-32-byte-secret
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# AI provider keys, model IDs and limits are configured through /admin.
RESEND_API_KEY=
EMAIL_FROM=HOLYAI <noreply@example.com>
REQUIRE_EMAIL_VERIFICATION=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=holyai
S3_ACCESS_KEY_ID=holyai
S3_SECRET_ACCESS_KEY=change-me-storage-secret
S3_FORCE_PATH_STYLE=true
CANVA_REDIRECT_URI=http://localhost:3000/api/integrations/canva/callback
# 64 hex characters; openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Admin provider credentials: separate 32-byte AES key, never stored in the database.
# Generate once in the deployment secret manager. Back it up separately from PostgreSQL.
CREDENTIAL_ENCRYPTION_KEY=
# Optional: exact HTTPS endpoint URLs for FUTURE custom adapters. No generic outbound adapter is enabled.
AI_ENDPOINT_ALLOWLIST=
APP_VERSION=0.1.0
# Infrastructure-only Supabase configuration; do not edit active database credentials through admin forms.
# Set DATABASE_URL above to the appropriate Supabase PostgreSQL connection string.
# Existing user authentication is Better Auth over PostgreSQL; Supabase Auth is not silently substituted.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
