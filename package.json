{
  "name": "holyai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "worker": "tsx --env-file-if-exists=.env src/server/workers/main.ts",
    "postinstall": "prisma generate",
    "db:local": "node scripts/dev-database.mjs",
    "storage:init": "tsx --env-file-if-exists=.env scripts/storage-init.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "6.19.0",
    "@huggingface/inference": "^4.13.32",
    "better-auth": "^1.4.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "react-hook-form": "^7.62.0",
    "@hookform/resolvers": "^5.0.0",
    "next-themes": "^0.4.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-highlight": "^7.0.2",
    "katex": "^0.19.1",
    "openai": "^6.0.0",
    "@anthropic-ai/sdk": "^0.71.0",
    "bullmq": "^5.60.0",
    "ioredis": "^5.7.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "mammoth": "^1.10.0",
    "pdf-parse": "^2.4.0",
    "docx": "^9.5.0",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "pptxgenjs": "^4.0.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.56.0",
    "dotenv": "^17.2.0",
    "prettier": "^3.6.0",
    "embedded-postgres": "17.10.0-beta.17"
  },
  "type": "module",
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0",
    "image-size": "^2.0.3",
    "uuid": "^11.1.1",
    "katex": "^0.19.1"
  }
}
